#!/usr/bin/with-contenv bashio
# TLS-Terminierung fuer die zugewiesene Subdomain, Weiterleitung an HA
# Core. Vier Schritte: HA-Core-Proxy-Check
# (Warnung, kein Abbruch), auf das Zertifikat warten, auf das
# WireGuard-Interface warten, Config rendern + nginx im Vordergrund
# starten.

STATE_FILE="${HAPROX_STATE_PATH:-/data/haprox.json}"
LEGO_PATH="${HAPROX_LEGO_PATH:-/data/lego}"

# --- 0) HA-Core-Port von der Supervisor-API abfragen --------------------
# Echter Bug, live gefunden: HA Core hoert nicht ueberall auf 8123 --
# auf dieser Test-VM (Supervised auf generischem Debian statt HAOS)
# laeuft es auf Port 80. Der fest verdrahtete Port fuehrte dort zu einem
# echten "502 Bad Gateway", weil niemand auf 127.0.0.1:8123 lauschte.
# /core/info kennt den tatsaechlichen Port, Fallback 8123 nur falls die
# Abfrage selbst fehlschlaegt.
HA_CORE_PORT=$(curl -s -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    http://supervisor/core/info | jq -r '.data.port // 8123')
if [ -z "${HA_CORE_PORT}" ] || [ "${HA_CORE_PORT}" = "null" ]; then
    HA_CORE_PORT=8123
fi

# --- 1) HA-Core-Trusted-Proxies-Check ---------------------------------
# configuration.yaml wird NICHT geparst (HA migriert das gerade uneinheitlich ins UI) --
# stattdessen empirisch pruefen, ob HA Core einen Request mit
# X-Forwarded-For (genau das, was unser eigenes nginx gleich schickt)
# mit 400 ablehnt.
ha_status=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 \
    -H "X-Forwarded-For: 203.0.113.1" "http://127.0.0.1:${HA_CORE_PORT}/" || echo "000")
if [ "${ha_status}" = "400" ]; then
    # Echter Bug, live gefunden: auf "Supervised"-Installationen auf
    # generischem Linux laeuft der homeassistant-Container oft selbst mit
    # Host-Networking. Laeuft dann auch dieses Add-on mit Host-Networking
    # (Pflicht fuer das WireGuard-Interface), sieht HA Core Anfragen von
    # hier als von 127.0.0.1 kommend -- NICHT vom Supervisor-Docker-Netz
    # 172.30.33.0/24. Beide Adressen eintragen deckt beide Faelle ab
    # (echte HAOS mit eigenem Add-on-Netz UND host-genetzwerkte Core).
    bashio::log.warning "Home Assistant Core vertraut diesem Add-on noch nicht als Proxy (400 Bad Request)."
    bashio::log.warning "Fuege in der configuration.yaml folgenden Block ein (aeltere HA-Versionen):"
    bashio::log.warning "  http:"
    bashio::log.warning "    use_x_forwarded_for: true"
    bashio::log.warning "    trusted_proxies:"
    bashio::log.warning "      - 172.30.33.0/24"
    bashio::log.warning "      - 127.0.0.1/32"
    bashio::log.warning "Oder (neuere HA-Versionen, UI): Einstellungen -> System -> Netzwerk ->"
    bashio::log.warning "HTTP-Server -> 'Trust X-Forwarded-For' aktivieren, beide Adressen"
    bashio::log.warning "172.30.33.0/24 und 127.0.0.1/32 bei 'Trusted proxies' eintragen."
    bashio::log.warning "(Laeuft Home Assistant Core auf dieser Box ebenfalls mit Host-Networking"
    bashio::log.warning "-- typisch bei 'Supervised' auf generischem Linux -- greift nur die"
    bashio::log.warning "127.0.0.1/32-Adresse, die andere schadet aber nicht.)"
    bashio::log.warning "Ohne das schlagen Verbindungen ueber haprox.eu fehl, sobald das Zertifikat steht."
fi

# --- 2) Auf das Zertifikat warten --------------------------------------
DOMAIN=$(jq -r '.domain' "${STATE_FILE}")
CERT_FILE="${LEGO_PATH}/certificates/${DOMAIN}.crt"
KEY_FILE="${LEGO_PATH}/certificates/${DOMAIN}.key"

if [ ! -f "${CERT_FILE}" ] || [ ! -f "${KEY_FILE}" ]; then
    bashio::log.info "Warte auf das Zertifikat fuer ${DOMAIN}..."
    while [ ! -f "${CERT_FILE}" ] || [ ! -f "${KEY_FILE}" ]; do
        sleep 5
    done
fi

# --- 3) Auf das WireGuard-Interface warten -----------------------------
# Echter Bug beim Test auf echtem HA Supervised: services.d-Dienste
# starten ohne garantierte Reihenfolge -- existierte das Zertifikat
# bereits (Neustart-Fall), versuchte nginx oft schneller zu binden, als
# services.d/wireguard/run das Interface hochgefahren hatte
# ("bind() to <wg_ip>:443 failed: Address not available"). Warten, bis
# die Adresse wirklich auf einem Interface sitzt, nicht nur aufs
# Zertifikat verlassen.
WG_IP=$(jq -r '.wg_ip' "${STATE_FILE}")
WG_SUBNET=$(jq -r '.wg_subnet' "${STATE_FILE}")
# Projektweite /24-Konvention: die VPS-Tunnel-IP ist innerhalb des
# zugewiesenen Subnetzes immer die .1.
VPS_TUNNEL_IP="${WG_SUBNET%.*}.1"

if ! ip -4 addr show wghaprox 2>/dev/null | grep -q "${WG_IP}/"; then
    bashio::log.info "Warte auf das WireGuard-Interface (${WG_IP})..."
    while ! ip -4 addr show wghaprox 2>/dev/null | grep -q "${WG_IP}/"; do
        sleep 2
    done
fi

# --- 4) Config rendern --------------------------------------------------
mkdir -p /run/nginx /etc/nginx/http.d
cat > /etc/nginx/http.d/haprox.conf <<EOF
server {
    listen ${WG_IP}:443 ssl proxy_protocol;
    server_name ${DOMAIN};

    # Wird von nichts in diesem Add-on gelesen und waechst sonst
    # unbegrenzt (echte Besucher-IPs/User-Agents inklusive) -- niemand
    # rotiert das in diesem minimalen Container.
    access_log off;

    ssl_certificate     ${CERT_FILE};
    ssl_certificate_key ${KEY_FILE};

    set_real_ip_from ${VPS_TUNNEL_IP};
    real_ip_header proxy_protocol;

    location / {
        proxy_pass http://127.0.0.1:${HA_CORE_PORT};
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-For \$remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # Echter Bug, live gefunden: ohne Upgrade/Connection-Header kann
        # nginx die WebSocket-Verbindung (/api/websocket) nicht
        # durchreichen, auf die die Companion-App (und das Frontend fuer
        # Live-Updates) zwingend angewiesen ist. Normale HTTP-Requests
        # (Login-Seite, REST) liefen deshalb weiterhin einwandfrei --
        # nur die App haengt in einer "Failed to connect"-Schleife, weil
        # sie nie eine funktionierende Websocket-Verbindung bekommt.
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
        # Default (60s) killt eine idle liegende Websocket-Verbindung
        # zwischen Events -- HA haelt sie oft laenger offen.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
EOF

bashio::log.info "Starte nginx (${DOMAIN} -> 127.0.0.1:${HA_CORE_PORT})..."
exec nginx -g "daemon off;"
